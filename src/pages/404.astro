---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found" page="home" description="The page you are looking for does not exist.">
  <div class="min-h-screen flex flex-col items-center justify-center gap-3 text-center px-6">
    <p class="font-display font-extrabold text-[clamp(3rem,10vw,5rem)] leading-none text-purple">404</p>
    <h1 class="font-display font-extrabold text-xl text-t1">Page not found</h1>
    <p class="text-sm text-t2 max-w-90">The page you are looking for does not exist or has been moved.</p>
    <a
      href="/"
      class="mt-2 inline-flex items-center px-5 py-2.5 rounded-[10px] bg-purple text-white
             font-display font-bold text-sm transition-opacity hover:opacity-85"
    >
      Back to home
    </a>
  </div>
</Layout>