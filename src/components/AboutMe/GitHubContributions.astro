---
interface Props {
  username: string;
}

const { username } = Astro.props;

const githubUrl = `https://github.com/${username}`;
const contributionUrl = `https://ghchart.rshah.org/7c3aed/${username}`;
---

<section
  class="surface-card p-7 animate-fade-up delay-400 w-full min-w-0 overflow-hidden"
  aria-labelledby="github-contributions-heading"
>
  <div class="flex items-center justify-between gap-4 mb-5">
    <div class="min-w-0">
      <h2
        id="github-contributions-heading"
        class="text-base font-bold font-display mb-1"
      >
        GitHub Contributions
      </h2>

      <p class="text-xs text-t2">
        My coding activity over the past year.
      </p>
    </div>

    <a
      href={githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3 py-1.5
             rounded-lg bg-s2 border border-border
             text-xs font-semibold text-t2 shrink-0
             transition-all duration-200
             hover:text-t1 hover:border-border-h"
      aria-label={`View ${username} on GitHub`}
    >
      GitHub

      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M7 17 17 7" />
        <path d="M7 7h10v10" />
      </svg>
    </a>
  </div>

  <a
    href={githubUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="block w-full min-w-0"
    aria-label={`View ${username}'s GitHub contributions`}
  >
    <div
      class="github-chart w-full min-w-0 rounded-xl border border-border
             bg-s2 overflow-hidden"
    >
      <div class="w-full p-4">
        <img
          src={contributionUrl}
          alt={`${username}'s GitHub contribution graph`}
          width="720"
          height="112"
          loading="lazy"
          decoding="async"
          class="block w-full max-w-full h-auto opacity-90
                 transition-opacity duration-200
                 hover:opacity-100"
        />
      </div>
    </div>
  </a>

  <div class="flex items-center gap-2 mt-4">
    <span
      class="w-2 h-2 rounded-full bg-purple shrink-0"
      aria-hidden="true"
    ></span>

    <span class="text-[11px] text-t2">
      @{username}
    </span>
  </div>
</section>