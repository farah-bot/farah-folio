---
interface Props {
  username: string;
}

const { username } = Astro.props;

const githubUrl = `https://github.com/${username}`;
const contributionUrl = `https://ghchart.rshah.org/7c3aed/${username}`;
---

<section
  class="surface-card p-7 animate-fade-up delay-400 w-full min-w-0 overflow-hidden"
  aria-labelledby="github-contributions-heading"
>
  <div class="flex items-center justify-between gap-4 mb-5">
    <div class="min-w-0">
      <h2
        id="github-contributions-heading"
        class="text-base font-bold font-display mb-1"
      >
        GitHub Contributions
      </h2>

      <p class="text-xs text-t2">
        My coding activity over the past year.
      </p>
    </div>

  </div>

  <a
    href={githubUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="block w-full min-w-0"
    aria-label={`View ${username}'s GitHub contributions`}
  >
    <div
      id="github-chart-tile"
      class="github-chart w-full min-w-0 rounded-xl border border-border
             bg-s2 overflow-hidden will-change-transform"
      style="perspective:900px; transform-style: preserve-3d;"
    >
      <div class="w-full p-4">
        <img
          src={contributionUrl}
          alt={`${username}'s GitHub contribution graph`}
          width="720"
          height="112"
          loading="lazy"
          decoding="async"
          class="block w-full max-w-full h-auto opacity-90
                 transition-opacity duration-200
                 hover:opacity-100"
        />
      </div>
    </div>
  </a>

</section>


<script>
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const tile = document.getElementById('github-chart-tile');

if (tile && !reduceMotion) {
  const STIFFNESS = 0.12;
  const DAMPING = 0.78;

  let rx = 0;
  let ry = 0;
  let vrx = 0;
  let vry = 0;
  let targetRx = 0;
  let targetRy = 0;
  let raf: number | null = null;

  function loop() {
    vrx = (vrx + (targetRx - rx) * STIFFNESS) * DAMPING;
    vry = (vry + (targetRy - ry) * STIFFNESS) * DAMPING;
    rx += vrx;
    ry += vry;
    tile!.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;

    const settled =
      Math.abs(vrx) < 0.01 &&
      Math.abs(vry) < 0.01 &&
      Math.abs(targetRx - rx) < 0.01 &&
      Math.abs(targetRy - ry) < 0.01;

    raf = settled ? null : requestAnimationFrame(loop);
  }

  function ensureLoop() {
    if (!raf) raf = requestAnimationFrame(loop);
  }

  tile.addEventListener('pointermove', (e: PointerEvent) => {
    const rect = tile!.getBoundingClientRect();
    const relX = (e.clientX - rect.left - rect.width / 2) / (rect.width / 2);
    const relY = (e.clientY - rect.top - rect.height / 2) / (rect.height / 2);
    targetRx = relY * -6;
    targetRy = relX * 6;
    ensureLoop();
  });

  tile.addEventListener('pointerleave', () => {
    targetRx = 0;
    targetRy = 0;
    ensureLoop();
  });
}
</script>